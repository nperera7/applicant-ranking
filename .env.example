# Applicant Ranking settings (prefix AR_). Copy to .env for local use; .env is git-ignored.
# Every value here is a safe placeholder or the built-in default. Never commit real keys:
# in production, inject secrets from Secret Manager as environment variables.
# Lines starting with "#" show optional settings with their defaults.
# Check the effective configuration (secrets hidden) with: applicant-ranking doctor

# dev | test | prod. Outside dev/test, AR_HMAC_KEY is required. The container image sets prod.
AR_ENV=dev

# --- Lever ---------------------------------------------------------------------------
# Data API key (Basic auth username). Needed for rank, evaluate, backtest, postings, purge.
AR_LEVER_API_KEY=
# https://api.eu.lever.co/v1 for accounts on hire.eu.lever.co. Must be https.
# AR_LEVER_BASE_URL=https://api.lever.co/v1
# Lever user id that tags and notes are attributed to (default: the API key's name).
# AR_LEVER_PERFORM_AS=
# The API key may read confidential postings and opportunities (granted by a Lever admin;
# see docs/legal-hr-questions.md). Off by default: "postings list" then omits them.
# AR_LEVER_CONFIDENTIAL_ACCESS=false
# Requests per second (max 10) and burst (max 20) for Lever's rate limit.
# AR_LEVER_RATE_PER_SECOND=8.0
# AR_LEVER_BURST=15
# AR_LEVER_TIMEOUT_SECONDS=30.0
# AR_LEVER_MAX_RETRIES=5
# One signature token per Lever webhook, as JSON: event name -> token. The service
# rejects (401) a handled event (applicationCreated, candidateDeleted) without one.
# AR_LEVER_WEBHOOK_TOKENS={"applicationCreated": "<token>", "candidateDeleted": "<token>"}
# Accept webhook triggeredAt within this many seconds of now (either direction).
# AR_WEBHOOK_MAX_AGE_SECONDS=600

# --- Gemini on Vertex AI ---------------------------------------------------------------
# An Egen GCP project with Vertex AI enabled. Credentials come from Application Default
# Credentials (the Cloud Run service account); no key file is configured here.
AR_GCP_PROJECT=
# gemini-3.1-pro-preview is served on the global endpoint only (no data residency).
# AR_GCP_LOCATION=global
# AR_GEMINI_MODEL=gemini-3.1-pro-preview
# low | medium | high
# AR_GEMINI_THINKING_LEVEL=low
# AR_GEMINI_TIMEOUT_SECONDS=180
# AR_GEMINI_MAX_OUTPUT_TOKENS=16384
# AR_GEMINI_RETRY_ATTEMPTS=4
# Best-effort reproducibility only.
# AR_GEMINI_SEED=7
# Parallel model calls per run.
# AR_LLM_CONCURRENCY=4
# Concurrent Lever reads/downloads, resume preparation and write-backs per run.
# AR_IO_CONCURRENCY=4

# --- Write-back to Lever ---------------------------------------------------------------
# Master switch. Live write-back also needs --mode live, approved criteria and a passing
# jurisdiction policy. Keep false until the backtest and Legal/HR sign-off are done.
AR_WRITE_ENABLED=false
# Managed tags look like "AI Rank: Tier A". Must not be empty.
# AR_TAG_PREFIX=AI Rank
# Also add "AI Rank: Score 80-89"-style band tags.
# AR_WRITE_SCORE_BAND_TAG=false
# AR_NOTE_SECRET=false
# AR_NOTE_NOTIFY_FOLLOWERS=false
# AR_NOTE_MAX_CHARS=3000

# --- Files and storage -------------------------------------------------------------------
# AR_CRITERIA_DIR=criteria
# Legal/HR-approved jurisdiction policy; see config/policy.example.yaml. Missing = blocked.
# AR_POLICY_FILE=config/policy.yaml
# Custom protected-term list (default: the packaged list).
# AR_PROTECTED_TERMS_FILE=
# SQLite state (audit log, PII store, caches). Holds candidate data: keep it private.
# AR_STATE_DB=data/state.sqlite3
# Key for HMAC fingerprints of resumes in the audit log. Required outside dev. Use a long
# random value from Secret Manager, e.g. the output of: openssl rand -hex 32
AR_HMAC_KEY=
# Also store the redacted resume text with each evaluation.
# AR_STORE_RESUME_TEXT=false
# Days to keep evaluations (minimum 365; default 4 years, the CA FEHA floor).
# AR_RETENTION_DAYS=1461

# --- Resume handling -----------------------------------------------------------------------
# AR_MAX_RESUME_BYTES=10485760
# AR_MAX_PDF_PAGES=10
# AR_MAX_RESUME_CHARS=30000
# AR_REDACT_EDUCATION_YEARS=true
# AR_EXTRACTION_TIMEOUT_SECONDS=30.0
# Parse PDF/DOCX in worker processes (PDFium is not thread-safe).
# AR_EXTRACTION_IN_SUBPROCESS=true
# Worker processes for resume parsing.
# AR_EXTRACTION_MAX_WORKERS=2
# Pages of a scanned resume sent for transcription.
# AR_VISION_MAX_PAGES=5

# --- Scoring -----------------------------------------------------------------------------
# Minimum score for tiers A, B and C (must satisfy A > B > C; below C is tier D).
# AR_TIERS__A=80
# AR_TIERS__B=65
# AR_TIERS__C=45
# |computed score - model's own estimate| at or above this adds an info flag.
# AR_DISAGREEMENT_THRESHOLD=30
